NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/realtime-chat-app
JWT_SECRET=replace_with_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_long_random_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_PARTITIONED=false

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOW_VERCEL_PREVIEWS=true
SERVER_URL=http://localhost:5000/api

RATE_LIMIT_MAX=400
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=35
AUTH_RATE_LIMIT_WINDOW_MS=60000
MESSAGE_RATE_LIMIT_MAX=180
MESSAGE_RATE_LIMIT_WINDOW_MS=60000

CLOUDINARY_CLOUD_NAME=replace_cloud_name
CLOUDINARY_API_KEY=replace_cloudinary_key
CLOUDINARY_API_SECRET=replace_cloudinary_secret

